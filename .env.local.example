# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="kharcha"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed on Vercel so Auth.js trusts the host header
AUTH_TRUST_HOST=true

# Email sign-up and password reset links, sent over SMTP. For Gmail, SMTP_PASS is an app password
# (Google Account > Security > App passwords), not your normal password.
# Without SMTP_HOST, `npm run dev` prints the emails to the server console; in production they fail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Kharcha"
# Public address of the app, used in emailed links. Optional on Vercel (the production URL is used).
# AUTH_URL="https://YOUR-APP.vercel.app"

# Shown on the Privacy and Terms pages. Leave unset to hide the contact line.
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"

# Web push — generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for cron-job.org / GitHub Actions calls
CRON_SECRET=""

# Set to 1 to run without sign-in or server, with sample data (local preview only)
# NEXT_PUBLIC_DEMO=1
